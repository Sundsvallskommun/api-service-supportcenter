{
	"request": {
		"method": "POST",
		"urlPath": "/sysman-sundsvall/api/v2/message/target",
		"bodyPatterns": [
			{
				"equalToJson": {
					"targets": [
						"AB12345"
					],
					"messagesToSend": [
						1
					],
					"targetType": "Computer",
					"targetAll": false
				},
				"ignoreExtraElements": true
			}
		]
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"jsonBody": {
			"message": "The message service is not responding",
			"details": [
				"the queue host refused the connection"
			],
			"code": "MessageServiceUnavailable"
		},
		"status": 500
	},
	"name": "sysman-sundsvall-is-unwell"
}
